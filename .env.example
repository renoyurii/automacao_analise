# Copie este arquivo para .env e preencha os valores antes de executar.
# O arquivo .env NUNCA deve ser commitado — adicione-o ao .gitignore.

# Shodan — https://account.shodan.io/ → "My Account" → API Key
SHODAN_API_KEY=sua_chave_aqui

# Anthropic — https://console.anthropic.com/ → API Keys
# Recomendado: quando configurado, ativa simultaneamente:
#   1. Vision AI — descreve páginas-imagem em PDFs (diagramas, fluxos) em texto
#   2. Extração via LLM — substitui o regex como fonte primária do M1, com Tool Use
#      estruturado e citação textual por item declarado (auditável).
# Sem essa key o M1 cai no fallback regex (mais frágil em phrasing variado).
ANTHROPIC_API_KEY=sua_chave_aqui

# Opcional: modelo Claude usado pelo M1 LLM extractor.
# Default: claude-haiku-4-5-20251001 (rápido + barato, ~$0.002/documento).
# Para máxima precisão, use claude-sonnet-4-5-20251001.
# M1_LLM_MODEL=claude-haiku-4-5-20251001

# Opcional: força fallback regex mesmo com ANTHROPIC_API_KEY configurada.
# M1_LLM_DISABLE=1
